{
  "name": "atiic",
  "version": "1.5.3",
  "description": "JavaScript I2C and SPI drivers for sensors and displays (MPU-6050, BMX055, MAX30102, VL53L1X, ST7735, GC9A01, SSD1680 e-paper ...), adapter-free; WCH's CH341 as the USB bridge, in Node.js and over WebUSB",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./adapters/ch341": "./src/adapters/ch341/index.js",
    "./adapters/ch341/node": "./src/adapters/ch341/node.js",
    "./adapters/ch347": "./src/adapters/ch347/index.js",
    "./adapters/ch347/node": "./src/adapters/ch347/node.js",
    "./adapters/dart": "./src/adapters/dart/index.js",
    "./adapters/dart/node": "./src/adapters/dart/node.js"
  },
  "scripts": {
    "test": "node --test \"test/host/*.test.js\"",
    "test:board": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/board/*.test.js\"",
    "lint": "eslint --fix",
    "test:advanced": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/advanced/*.test.js\"",
    "demo:qr": "node --env-file-if-exists=.env.local demo/epaper-qr.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aguegu/atiic.git"
  },
  "keywords": [
    "i2c",
    "spi",
    "ch341",
    "ch341a",
    "webusb",
    "nodejs",
    "sensor",
    "driver",
    "imu",
    "mpu6050",
    "mpu6500",
    "bmx055",
    "adxl345",
    "hmc5883l",
    "itg3200",
    "max30102",
    "sht20",
    "aht21",
    "vl53l1x",
    "mlx90614",
    "ina231",
    "ina226",
    "st7735",
    "gc9107",
    "gc9a01",
    "ssd1680",
    "ssd1681",
    "st7302",
    "e-paper",
    "e-ink",
    "tft",
    "display",
    "at24c08",
    "eeprom"
  ],
  "author": "aGuegu <weihong.guan@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aguegu/atiic/issues"
  },
  "homepage": "https://github.com/aguegu/atiic#readme",
  "peerDependencies": {
    "usb": "^3.2.1"
  },
  "peerDependenciesMeta": {
    "usb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "qrcode-generator": "^2.0.4",
    "usb": "3.2.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
