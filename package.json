{
  "name": "atiic",
  "version": "1.2.5",
  "description": "JavaScript drivers for I2C devices, adapter-free; WCH's CH341 as the USB-to-I2C adapter, in Node and over WebUSB",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./adapters/ch341": "./src/adapters/ch341/index.js",
    "./adapters/ch341/node": "./src/adapters/ch341/node.js"
  },
  "scripts": {
    "test": "node --test \"test/host/*.test.js\"",
    "test:board": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/board/*.test.js\"",
    "lint": "eslint --fix",
    "test:advanced": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/advanced/*.test.js\"",
    "demo:qr": "node --env-file-if-exists=.env.local demo/epaper-qr.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aguegu/atiic.git"
  },
  "keywords": [
    "i2c",
    "ch341",
    "webusb"
  ],
  "author": "aGuegu <weihong.guan@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aguegu/atiic/issues"
  },
  "homepage": "https://github.com/aguegu/atiic#readme",
  "peerDependencies": {
    "usb": "^3.2.1"
  },
  "peerDependenciesMeta": {
    "usb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "qrcode-generator": "^2.0.4",
    "usb": "3.2.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
